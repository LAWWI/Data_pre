# ======== ข้อมูลดิบ ========
# creditcard.csv commit มาด้วยแล้วผ่าน Git LFS (ดู .gitattributes)
*.zip

# ======== ผลลัพธ์ที่ pipeline สร้างเอง ========
# outputs/ commit มาด้วยทั้งหมด เพื่อให้ตรวจผลได้โดยไม่ต้องรัน pipeline ซ้ำ
# (processed.npz ขนาด ~73 MB เก็บผ่าน Git LFS)
# log ของแต่ละรอบไม่ commit — สร้างใหม่ทุกครั้งที่รัน main.py
logs/*
!logs/.gitkeep

# ไฟล์ binary/โมเดล ที่หลงมาอยู่นอก outputs/ (anchor ที่ root เท่านั้น
# ไม่ให้ไปบังของใน outputs/)
/*.npz
/*.joblib
/*.pkl

# ======== Python ========
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# virtual environment
.venv/
venv/
env/
ENV/

# ======== cache ของเครื่องมือ ========
.ipynb_checkpoints/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ======== editor / IDE ========
.vscode/
.idea/
*.swp

# ======== ระบบปฏิบัติการ ========
Thumbs.db
desktop.ini
.DS_Store
